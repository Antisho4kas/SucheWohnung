# ---- Core ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Database (PostgreSQL 16 + PostGIS) ----
# For Docker: use service names (postgres, redis, api)
# For local dev: use localhost
DATABASE_URL=postgresql://app:app@postgres:5432/suchewohnung?schema=public

# ---- Redis 7 (queues + cache + rate-limit) ----
REDIS_URL=redis://redis:6379

# ---- API ----
API_PORT=3000
API_BASE_URL=http://api:3000

# ---- Auth (JWT RS256) ----
# Base64-encoded PEM keys (generate with: openssl genrsa ... | base64 -w0)
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Credentials envelope encryption (AES-256-GCM) ----
# 32-byte key, base64-encoded
DATA_ENCRYPTION_KEY_BASE64=

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=SucheWohnungBot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_WEBHOOK_URL=

# ---- Email (verification / reset) ----
SMTP_URL=
EMAIL_FROM=no-reply@suchewohnung.de

# ---- Geocoding (Nominatim) ----
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
GEOCODE_CACHE_TTL_SECONDS=2592000

# ---- Limits / business rules ----
FREE_PROFILE_LIMIT=3
PREMIUM_PROFILE_LIMIT=20

# Default seller-reply text shown as a copyable block under each Telegram
# listing notification (used when a profile has no autoReplyText of its own).
# The user taps the block to copy it, then pastes and sends manually from their
# kleinanzeigen account. Leave empty to show only the "open listing" button.
DEFAULT_AUTOREPLY_TEXT=

# ---- Observability ----
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
METRICS_PORT=9100

# ---- Scraping ----
PROXY_URL=
SCRAPER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) SucheWohnungBot/1.0
# Proxy for the kleinanzeigen-api Playwright scraper (kleinanzeigen blocks
# datacenter/VPS IPs). A residential proxy is strongly recommended.
# Format: http(s)://user:pass@host:port or socks5://user:pass@host:port
KLEINANZEIGEN_PROXY=
