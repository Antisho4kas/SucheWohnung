// SucheWohnung — Prisma schema (mirrors sql/schema.sql / §07 Database Design).
// PostgreSQL 16 + PostGIS. UUID PKs. Geo columns are managed via raw SQL
// migration (PostGIS geography type is not natively modeled by Prisma).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis, pg_trgm, uuidOssp(map: "uuid-ossp"), citext]
}

enum UserRole {
  user
  premium
  admin
  super_admin

  @@map("user_role")
}

enum UserStatus {
  pending
  active
  suspended
  deleted

  @@map("user_status")
}

enum IntegrationType {
  api
  scrape

  @@map("integration_type")
}

enum ListingStatus {
  active
  updated
  expired
  removed

  @@map("listing_status")
}

model User {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String     @db.Citext
  passwordHash    String     @map("password_hash")
  role            UserRole   @default(user)
  status          UserStatus @default(pending)
  locale          String     @default("de")
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  searchProfiles        SearchProfile[]
  telegramSubscriptions TelegramSubscription[]
  consents              UserConsent[]
  auditLogs             AuditLog[]
  refreshTokens         RefreshToken[]
  emailTokens           EmailToken[]

  @@map("users")
}

// Refresh tokens (hashed, rotating) — §08.3 / §13.1. Not in original DDL
// excerpt but required to implement refresh-token rotation; additive.
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// Email verification + password reset + telegram link tokens.
model EmailToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String // verify_email | password_reset | telegram_link
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

model Source {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug            String          @unique
  name            String
  integrationType IntegrationType @map("integration_type")
  isActive        Boolean         @default(false) @map("is_active")
  scheduleCron    String          @default("*/15 * * * *") @map("schedule_cron")
  rateLimitRpm    Int             @default(30) @map("rate_limit_rpm")
  breakerState    String          @default("closed") @map("breaker_state")
  config          Json            @default("{}")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  credentials SourceCredential[]
  listings    Listing[]
  runs        SourceRun[]

  @@map("sources")
}

model SourceCredential {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId        String   @map("source_id") @db.Uuid
  type            String // api_key | oauth | cookie | basic
  encryptedSecret Json     @map("encrypted_secret")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@map("source_credentials")
}

model Listing {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId    String        @map("source_id") @db.Uuid
  externalId  String        @map("external_id")
  fingerprint String        @unique
  url         String
  title       String?
  price       Decimal?      @db.Decimal(10, 2)
  warmRent    Decimal?      @map("warm_rent") @db.Decimal(10, 2)
  area        Decimal?      @db.Decimal(7, 2)
  rooms       Decimal?      @db.Decimal(4, 1)
  city        String?
  bundesland  String?
  postalCode  String?       @map("postal_code")
  // geo GEOGRAPHY(Point,4326) is added via raw SQL migration.
  attributes  Json          @default("{}")
  status      ListingStatus @default(active)
  firstSeenAt DateTime      @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz
  raw         Json?

  source  Source         @relation(fields: [sourceId], references: [id])
  history ListingHistory[]
  images  ListingImage[]
  matches Match[]

  @@unique([sourceId, externalId], name: "uq_source_external")
  @@index([city])
  @@index([postalCode])
  @@index([price])
  @@index([rooms])
  @@index([status, lastSeenAt])
  @@map("listings")
}

model ListingHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  field     String
  oldValue  Json?    @map("old_value")
  newValue  Json?    @map("new_value")
  changedAt DateTime @default(now()) @map("changed_at") @db.Timestamptz

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, changedAt])
  @@map("listing_history")
}

model ListingImage {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId  String  @map("listing_id") @db.Uuid
  url        String
  storageKey String? @map("storage_key")
  position   Int     @default(0)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_images")
}

model FilterDefinition {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique
  label       Json
  dataType    String   @map("data_type")
  operatorSet String[] @map("operator_set")
  config      Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  profileFilters ProfileFilter[]

  @@map("filter_definitions")
}

model SearchProfile {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  name             String
  isActive         Boolean  @default(true) @map("is_active")
  notify           Boolean  @default(true)
  autoReplyEnabled Boolean  @default(false) @map("auto_reply_enabled")
  autoReplyText    String?  @map("auto_reply_text")
  criteria         Json     @default("{}")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  filters ProfileFilter[]
  matches Match[]

  @@index([isActive])
  @@map("search_profiles")
}

model ProfileFilter {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId   String @map("profile_id") @db.Uuid
  filterDefId String @map("filter_def_id") @db.Uuid
  operator    String
  value       Json

  profile    SearchProfile    @relation(fields: [profileId], references: [id], onDelete: Cascade)
  definition FilterDefinition @relation(fields: [filterDefId], references: [id])

  @@map("profile_filters")
}

model Match {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  state     String   @default("pending")
  matchedAt DateTime @default(now()) @map("matched_at") @db.Timestamptz

  profile       SearchProfile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  listing       Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)
  notifications Notification[]
  sellerReplies SellerReply[]

  @@unique([profileId, listingId], name: "uq_profile_listing")
  @@index([profileId, matchedAt])
  @@map("matches")
}

model TelegramSubscription {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  chatId   BigInt   @map("chat_id")
  enabled  Boolean  @default(true)
  linkedAt DateTime @default(now()) @map("linked_at") @db.Timestamptz

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([userId, chatId], name: "uq_user_chat")
  @@map("telegram_subscriptions")
}

model Notification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId        String    @map("match_id") @db.Uuid
  subscriptionId String    @map("subscription_id") @db.Uuid
  channel        String    @default("telegram")
  status         String    @default("queued")
  dedupeKey      String    @unique @map("dedupe_key")
  error          String?
  sentAt         DateTime? @map("sent_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  match        Match                @relation(fields: [matchId], references: [id], onDelete: Cascade)
  subscription TelegramSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([status, createdAt])
  @@map("notifications")
}

// Auto-reply seam (Part 1): records the intended seller reply for a match when
// a profile has auto-reply enabled. The actual platform send is Part 2 (blocked
// on a connector capability), so recorded rows carry status "skipped_no_channel"
// until a send channel exists. Modeled on Notification.
model SellerReply {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  matchId   String    @map("match_id") @db.Uuid
  channel   String    @default("kleinanzeigen")
  status    String    @default("pending")
  body      String
  dedupeKey String    @unique @map("dedupe_key")
  error     String?
  sentAt    DateTime? @map("sent_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("seller_replies")
}

model SourceRun {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId     String    @map("source_id") @db.Uuid
  status       String
  itemsFetched Int       @default(0) @map("items_fetched")
  itemsNew     Int       @default(0) @map("items_new")
  itemsUpdated Int       @default(0) @map("items_updated")
  errors       Int       @default(0)
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, startedAt])
  @@map("source_runs")
}

model UserConsent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  consentType String   @map("consent_type")
  granted     Boolean
  recordedAt  DateTime @default(now()) @map("recorded_at") @db.Timestamptz
  ipHash      String?  @map("ip_hash")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_consents")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  meta      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model JobQueueAudit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queue     String
  jobId     String   @map("job_id")
  sourceId  String?  @map("source_id") @db.Uuid
  status    String
  attempts  Int      @default(0)
  payload   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("job_queue_audit")
}
